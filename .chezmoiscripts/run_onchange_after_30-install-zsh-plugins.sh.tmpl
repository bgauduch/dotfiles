#!/usr/bin/env bash
# Install/verify vendored zsh plugins after files are applied. run_onchange so it
# re-runs when the lockfile changes; the bin script itself is idempotent.
# Hash of zsh-plugins.lock to retrigger on bump: {{ include "zsh-plugins.lock" | sha256sum }}
set -euo pipefail
if [ -x "${HOME}/.local/bin/install-zsh-plugins.sh" ]; then
  "${HOME}/.local/bin/install-zsh-plugins.sh"
else
  echo "install-zsh-plugins.sh not found on PATH yet — skipping" >&2
fi
