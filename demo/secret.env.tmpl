# chezmoi demo — secrets pattern (see docs/adr/0005).
# Only the Bitwarden *item reference* lives in git; the value is fetched at apply time.
#
# Prod (real machine) — chezmoi resolves this via the Bitwarden CLI at apply:
#   API_TOKEN={{ `{{ (bitwardenFields "chezmoi-demo" "api-token").value }}` }}
#
# Sandbox tour — a stub is injected via $DEMO_SECRET so this renders fully offline:
API_TOKEN={{ env "DEMO_SECRET" | default "<unset: unlock Bitwarden or export DEMO_SECRET>" }}
