# Bare browser VS Code (code-server) for the from-zero demo: plain Debian + the
# prerequisites the chezmoi one-liner needs, NO baked source. Run ./demo/run-vscode.sh,
# open http://localhost:8080, then run the one-liner in the integrated terminal and watch
# the env build from an empty machine.
FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates sudo \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev
# code-server pinned by version (ADR-0003 bootstrap-installer pinning).
RUN curl -fsSL https://code-server.dev/install.sh | sh -s -- --version=4.127.0
# Expose a real `code` CLI. code-server bundles VS Code's remote CLI but only injects `code`
# as a shell FUNCTION in the integrated terminal, which chezmoi/git cannot exec. Symlinking
# the bundled remote CLI onto PATH gives a real binary: inside the integrated terminal
# ($VSCODE_IPC_HOOK_CLI set) `code --wait <file>` opens in the running browser window and
# blocks until the tab closes - exactly what `chezmoi edit` / `git commit` need. The zshrc
# editor guard (whence -p code) then picks it up automatically.
RUN ln -sf /usr/lib/code-server/lib/vscode/bin/remote-cli/code-server /usr/local/bin/code
USER dev
WORKDIR /home/dev
EXPOSE 8080
# --auth none: throwaway, local-only demo container. Never expose this publicly.
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "none", "/home/dev"]
