# Global mise config — runtimes (all OS) + TUI dev tools (Linux/WSL only).
#
# Routing (ADR-0002 "one manager per tool"): on macOS the TUI tools come from
# Homebrew (see Brewfile), so they are templated OUT here to avoid a two-manager
# duplicate. On Linux/WSL mise is the cross-OS layer that pins identical versions.
#
# Provenance (ADR-0003): lockfile = true makes mise VERIFY checksums at install
# (a lockfile without active verification is decorative). The resolved exact
# versions + checksums are recorded in mise.lock, committed to the repo on first
# `mise install` (generated on a real machine / in CI, not in this container).

[settings]
lockfile = true

[tools]
# --- Language runtimes (mise-managed on every OS; identical versions cross-OS) ---
# Pinned explicit versions (ADR-0003); bump deliberately via `mise latest <tool>`.
node = "24.18.0"
go = "1.26.4"
python = "3.14.6"

# --- Cloud / IaC tooling (mise-managed on every OS, all profiles - transverse) ---
# terraform is pinned via the explicit aqua backend on purpose: the bare `terraform`
# name resolves to the asdf backend, which locks a URL WITHOUT a checksum; aqua ships
# per-platform sha256 so lockfile = true verification (ADR-0003) actually bites.
"aqua:hashicorp/terraform" = "1.15.7"
# awscli: AWS distributes CLI v2 as .pkg/.zip installers with NO upstream sha256, so
# this is the one tool mise cannot checksum-verify (URL + version pin only): a
# documented exception to ADR-0003, not an oversight. macOS/Linux only (no Windows).
awscli = "2.35.14"

{{ if ne .chezmoi.os "darwin" -}}
# --- TUI stack (Linux/WSL via mise; macOS uses Homebrew — see Brewfile) ---
zellij = "0.44.3"
helix = "25.07.1"
yazi = "26.5.6"
lazygit = "0.62.2"
starship = "1.26.0"
{{- end }}

# --- LSP servers (ADR-0002: LSPs are mise tools like any other) ---
# DEFERRED: added after confirming exact mise registry names on a real machine,
# to keep the integration-test CI green. Intended set (see helix/languages.toml):
#   terraform-ls, gopls, bash-language-server, yaml-language-server, marksman.

{{ if eq .profile "work" -}}
# --- Work-only tools (profile=work) — gated by the machine profile (ADR-0002).
# Empty by default; fill per work needs, e.g.:
#   kubectl   = "latest"
#   aws-vault = "latest"
{{- end }}
